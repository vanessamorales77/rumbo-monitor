# Use the built-in simulator (no network, no account). Set to "false" to hit Traccar.
VITE_USE_MOCK=true

# Traccar demo account you registered at https://demo4.traccar.org
VITE_TRACCAR_EMAIL=
VITE_TRACCAR_PASSWORD=

# API origin. Leave empty in dev (Vite proxies /api). In production, point it at the Cloudflare Worker.
VITE_TRACCAR_BASE=

# Dev proxy target (server-side only, not exposed to the browser)
TRACCAR_TARGET=https://demo4.traccar.org
