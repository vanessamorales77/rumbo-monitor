# Use the built-in simulator (no network, no account). Set to "false" to hit Traccar.
VITE_USE_MOCK=true

# Traccar demo account you registered at https://demo4.traccar.org
VITE_TRACCAR_EMAIL=
VITE_TRACCAR_PASSWORD=

# API origin. Leave empty in dev (Vite proxies /api). In production, point it at the Cloudflare Worker.
VITE_TRACCAR_BASE=

# Map tiles. Defaults to OpenStreetMap's public servers, fine for a demo but not for real traffic
# (see https://operations.osmfoundation.org/policies/tiles/). Point it at a provider you have a key for.
# VITE_TILE_URL=https://api.example.com/tiles/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_TILE_ATTRIBUTION=&copy; Provider &copy; OpenStreetMap contributors

# Dev proxy target (server-side only, not exposed to the browser)
TRACCAR_TARGET=https://demo4.traccar.org
